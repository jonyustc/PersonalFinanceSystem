PROJECT_NAME="Personal Finance Management API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-host:5432/postgres?ssl=require
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=180
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_DEFAULT=100/minute
# "Sign in with Google" — comma-separated OAuth client IDs accepted as the ID
# token audience. Use the Web client ID for the frontend; add the same Web
# client ID for the mobile app (passed as serverClientId to google_sign_in).
GOOGLE_CLIENT_IDS=68144707054-vugnb7edacn4vhtkuvvopqi7ooit2qns.apps.googleusercontent.com
